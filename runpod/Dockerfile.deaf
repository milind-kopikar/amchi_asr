# Deaf Speech ASR — RunPod Serverless worker
#
# Build from repo root:
#   docker build -f runpod/Dockerfile.deaf -t deaf-speech-asr-runpod .
#
# The checkpoint is NOT baked into this image.
# Set CHECKPOINT_URL to the public Cloudflare R2 URL when creating the endpoint.
# The handler downloads it to /tmp on first worker start.
#
# Required env vars when running the endpoint:
#   CHECKPOINT_URL   — public R2 URL for konkani_asr-epoch=21-val_wer=0.720.ckpt
#   GEMINI_API_KEY   — Gemini API key for post-processing

FROM nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

# Python 3.11 from the deadsnakes PPA.
#
# Why not Ubuntu's own python3.11 package: jammy-updates ships
# python3.11=3.11.0~rc1, the release candidate from before the
# CVE-2020-10735 patch that added sys.get_int_max_str_digits. Modern
# NeMo deps call that function, so the rc1 Python crashes at the
# conv_asr import with `AttributeError: module 'sys' has no attribute
# 'get_int_max_str_digits'`. deadsnakes maintains real 3.11.x releases.
#
# Why not Ubuntu's python3-pip: that package's pip targets Python 3.10
# (the OS default), so `pip install ...` puts packages in 3.10's
# site-packages while `python3` (switched via update-alternatives) runs
# 3.11. We bootstrap pip for 3.11 via get-pip.py instead (ensurepip is
# disabled on Debian/Ubuntu system Pythons).
RUN apt-get update && apt-get install -y --no-install-recommends \
        software-properties-common \
        ca-certificates \
        curl \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
        python3.11 python3.11-venv python3.11-dev python3.11-distutils \
        ffmpeg build-essential wget \
    && rm -rf /var/lib/apt/lists/*

# Make python3.11 the default python AND install a 3.11-bound pip via
# get-pip.py. Every subsequent install uses `python3.11 -m pip` so the
# Python and its pip are guaranteed to match.
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 \
    && update-alternatives --install /usr/bin/python  python  /usr/bin/python3.11 1 \
    && curl -sS https://bootstrap.pypa.io/get-pip.py -o /tmp/get-pip.py \
    && python3.11 /tmp/get-pip.py --no-cache-dir \
    && rm /tmp/get-pip.py \
    && python3.11 -m pip install --no-cache-dir --upgrade pip setuptools wheel \
    && python3.11 --version \
    && python3.11 -m pip --version

WORKDIR /app

# ── 1. PyTorch (CUDA 11.8 — matches training environment) ──────────────────
RUN python3.11 -m pip install --no-cache-dir \
       torch torchvision torchaudio \
       --index-url https://download.pytorch.org/whl/cu118

# ── 2. NeMo ASR (upstream, Python 3.11 compatible) ─────────────────────────
#    Use [asr] only — not [all] — to keep the image lean (~8 GB vs ~15 GB).
#    --ignore-installed blinker avoids a known conflict on Ubuntu 22.04.
RUN python3.11 -m pip install --no-cache-dir Cython \
    && python3.11 -m pip install --no-cache-dir \
       "nemo_toolkit[asr]" \
       --ignore-installed blinker \
       librosa omegaconf

# ── 3. Gemini post-processing + utilities ───────────────────────────────────
RUN python3.11 -m pip install --no-cache-dir \
    google-genai \
    jiwer \
    runpod

# ── 4. Repo code (handler, scripts, patches) ────────────────────────────────
COPY . /app

# ── 5. Apply conv_asr patch ─────────────────────────────────────────────────
#    The upstream NeMo hybrid CTC/RNNT model requires a patched conv_asr.py
#    to load fine-tuned checkpoints correctly. See patches/conv_asr_fixed.py.
RUN python3.11 -c "\
import nemo.collections.asr.modules.conv_asr as m; \
import shutil; \
shutil.copy('/app/patches/conv_asr_fixed.py', m.__file__); \
print('conv_asr patch applied to', m.__file__) \
"

# ── 6. Staged smoke checks ──────────────────────────────────────────────────
#    Each check is its own RUN so a build failure points at the exact
#    broken component. The smoke script's source lives in the repo (and is
#    unit-tested in tests/test_runpod_smoke.py).
RUN python3.11 scripts/runpod_smoke.py --check imports --variant deaf
RUN python3.11 scripts/runpod_smoke.py --check patch   --variant deaf
RUN python3.11 scripts/runpod_smoke.py --check handler --variant deaf

# ── Entry point ──────────────────────────────────────────────────────────────
CMD ["python3.11", "runpod/handler_deaf.py"]
