# Amchi Konkani ASR — RunPod Serverless worker
#
# Build from repo root:
#   # First, generate the dictionary JSON (one-time, or whenever the dict changes):
#   python3 scripts/build_amchi_dict.py
#
#   # Then build the image:
#   docker build -f runpod/Dockerfile.serverless -t milindkopi/amchi-asr-runpod:latest .
#
# The checkpoint is NOT baked into this image.
# Set CHECKPOINT_URL to the public Cloudflare R2 URL when creating the endpoint.
# The handler downloads it to /tmp on first worker start.
#
# Required env vars when running the endpoint:
#   CHECKPOINT_URL    — public R2 URL for konkani_asr-epoch=88-val_wer=0.334.ckpt
#   GEMINI_API_KEY    — optional; required for Gemini post-processing
#                       (without it the handler returns raw ASR with mode="SKIPPED")
#
# Optional:
#   AMCHI_DICT_PATH   — override the baked-in dictionary path. Defaults to
#                       /app/data/amchi_konkani_dict.json (which we COPY below).

# Ubuntu 24.04 + CUDA 12.8 — matches what the RunPod verification pod ran.
# That pod transcribed both deaf and amchi held-out samples at CER=0.0000
# (see docs/RUNPOD_VERIFY_HANDOFF.md), so this combination is end-to-end
# verified.  Ubuntu 24.04 ships Python 3.12.3 as the system python, with a
# properly-functioning python3-pip — so no deadsnakes/get-pip.py dance.
FROM nvidia/cuda:12.8.0-cudnn-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive

# System deps: python3 (3.12 on 24.04), python3-pip, ffmpeg (audio decode),
# build tools. No version juggling — the OS's python3 IS the right Python.
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-venv python3-pip python3-dev \
        ffmpeg build-essential wget curl \
    && rm -rf /var/lib/apt/lists/* \
    && python3 --version \
    && python3 -m pip --version

WORKDIR /app

# ── 1. PyTorch + NeMo, installed together in ONE pip pass ──────────────────
#
# Why in one pass: installing torch and nemo separately lets pip's resolver
# pick mismatched torchvision/torchaudio wheels (LEARNINGS.md §6), surfacing
# at runtime as `RuntimeError: operator torchvision::nms does not exist`.
# Pinning torch + torchaudio explicitly to cu128 wheels, while letting nemo
# pull its own deps in the same resolution, is what the pod verified.
#
# Why these exact versions: torch==2.10.0+cu128 was used by the verification
# pod and the training run (LEARNINGS.md §5 + RUNPOD_VERIFY_HANDOFF.md).
# nemo_toolkit[asr] is left unpinned — pip resolved to the version compatible
# with torch 2.10 on the pod.
#
# Why --ignore-installed blinker: a known Ubuntu conflict; harmless to keep.
RUN python3 -m pip install --no-cache-dir --break-system-packages \
        "torch==2.10.0+cu128" "torchaudio==2.10.0+cu128" \
        "nemo_toolkit[asr]" \
        librosa omegaconf jiwer google-genai runpod \
        --extra-index-url https://download.pytorch.org/whl/cu128 \
        --ignore-installed blinker

# ── 4. Repo code (handler, scripts, patches, dictionary) ───────────────────
#    The dictionary JSON must exist at data/amchi_konkani_dict.json before
#    `docker build` — generate it with `python3 scripts/build_amchi_dict.py`.
COPY . /app

# Fail the build early if the dictionary wasn't generated. Better to find out
# at build time than at the first inference request.
RUN test -f /app/data/amchi_konkani_dict.json \
    || (echo "ERROR: /app/data/amchi_konkani_dict.json is missing." \
        "Run 'python3 scripts/build_amchi_dict.py' before building this image." \
        && exit 1)

# ── 5. Apply conv_asr patch ─────────────────────────────────────────────────
#    The upstream NeMo hybrid CTC/RNNT model requires a patched conv_asr.py
#    to load fine-tuned checkpoints correctly. See patches/conv_asr_fixed.py.
RUN python3 -c "\
import nemo.collections.asr.modules.conv_asr as m; \
import shutil; \
shutil.copy('/app/patches/conv_asr_fixed.py', m.__file__); \
print('conv_asr patch applied to', m.__file__) \
"

# ── 6. Staged smoke checks ──────────────────────────────────────────────────
#    Each check is its own RUN so a build failure points at the exact
#    broken component. The smoke script's source lives in the repo (and is
#    unit-tested in tests/test_runpod_smoke.py).
RUN python3 scripts/runpod_smoke.py --check imports    --variant amchi
RUN python3 scripts/runpod_smoke.py --check patch      --variant amchi
RUN python3 scripts/runpod_smoke.py --check dictionary --variant amchi
RUN python3 scripts/runpod_smoke.py --check handler    --variant amchi

# ── Entry point ──────────────────────────────────────────────────────────────
CMD ["python3", "runpod/handler.py"]
