# Copy this file to .env and fill in your keys.
# .env is git-ignored — NEVER commit .env to git.
#
# Usage:
#   cp .env.example .env
#   # edit .env with your real keys
#   source .env          # or use: set -a && source .env && set +a

# Gemini API key — used by scripts/postprocess_asr.py and scripts/deaf_speech_inference.py
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Google TTS API key — used by webapp/src/app/api/tts/route.ts (server-side only)
# Set this in webapp/.env.local (local) and as a Railway env var (production).
# NEVER expose this key in frontend code or commit it to git.
# Get yours at: https://aistudio.google.com/apikey
GOOGLE_TTS_API_KEY=

# Hugging Face token — used by scripts/download_model_from_hf.py
# Get yours at: https://huggingface.co/settings/tokens
HF_TOKEN=

# GitHub Personal Access Token — used for git push over HTTPS
# Get yours at: https://github.com/settings/tokens
# Set it on the remote with:
#   git remote set-url origin https://${GITHUB_PAT}@github.com/milind-kopikar/amchi_asr.git
GITHUB_PAT=
