# Copy to .env.local and fill in your keys. Never commit .env.local to git.

# Google Cloud Text-to-Speech API key (used for Marathi + English TTS)
# Enable "Cloud Text-to-Speech API" in Google Cloud Console
GOOGLE_TTS_API_KEY=

# Gemini API key (used for Marathi → English translation in /api/tts-english)
# Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# RunPod credentials for the live DS-D transcription endpoint
# (set on Railway production, not locally unless smoke-testing)
RUNPOD_API_KEY=
RUNPOD_DEAF_ENDPOINT_ID=

# Deaf-speech collector (Express + Postgres on Railway) — receives
# /demo/live feedback, events, and survey data via the proxy routes
# under src/app/api/(feedback|events|survey)/*.
# COLLECTOR_BASE_URL: e.g. https://deafspeechcollector-production.up.railway.app
# COLLECTOR_API_KEY:  shared secret matching the collector's same env var
COLLECTOR_BASE_URL=
COLLECTOR_API_KEY=
