{"audio_filepath": "https://konkanicollector-production.up.railway.app/api/recordings/279/audio", "text": "बब्रुलिंगप्पागले समर्पण", "duration": 3.6375}
{"audio_filepath": "https://konkanicollector-production.up.railway.app/api/recordings/280/audio", "text": "बब्रुलिंगप्पा भीव्नु उटाय्लो", "duration": 3.695}
{"audio_filepath": "https://konkanicollector-production.up.railway.app/api/recordings/281/audio", "text": "रात्र भर ज़ोरु पाव्सु पड्तशिलो", "duration": 4.505}
{"audio_filepath": "https://konkanicollector-production.up.railway.app/api/recordings/282/audio", "text": "गांवांतु आय्ला ऊवारु म्हुणु रेडियोंतु आय्कलें", "duration": 5.1225}
{"audio_filepath": "https://konkanicollector-production.up.railway.app/api/recordings/283/audio", "text": "हांग थाव्नु वग्गि भाय्रसोर्का - हें ताक्का कळ्ळें", "duration": 4.8275}
{"audio_filepath": "https://konkanicollector-production.up.railway.app/api/recordings/284/audio", "text": "आकाशु तोग्गु येत्कि म्होण्च्वारि पाव्सु", "duration": 5.1875}
{"audio_filepath": "https://konkanicollector-production.up.railway.app/api/recordings/285/audio", "text": "मांड्कांगलि सवारी भाय्राय्लि पोळोनु वीज़ु!", "duration": 4.76}
{"audio_filepath": "https://konkanicollector-production.up.railway.app/api/recordings/286/audio", "text": "बाग्ला खांचेन्थाव्नु आयिलें भित्तरि उदाक....", "duration": 4.8675}
{"audio_filepath": "https://konkanicollector-production.up.railway.app/api/recordings/287/audio", "text": "ज़ाल्यारि स्वथागले भावनांक तान्ने सोणि वार्याक!", "duration": 6.2725}
{"audio_filepath": "https://konkanicollector-production.up.railway.app/api/recordings/288/audio", "text": "भवानीशङ्कर देवाचेरि तागलो आश्शिलो इत्लो विश्वासु", "duration": 6.8475}
{"audio_filepath": "https://konkanicollector-production.up.railway.app/api/recordings/289/audio", "text": "गोत्तशिलें ताका देवागले एक स्पर्षाने वत्ता वरुणागले आक्रोषु", "duration": 8.5325}
{"audio_filepath": "https://konkanicollector-production.up.railway.app/api/recordings/290/audio", "text": "उदाक निःशब्द भर्लें सग्ळे घरान्तु", "duration": 3.8675}
{"audio_filepath": "https://konkanicollector-production.up.railway.app/api/recordings/291/audio", "text": "बब्रुलिंगप्पा ज़ाडारि चोणु बस्लो घड्यांतु!", "duration": 5.89}
{"audio_filepath": "https://konkanicollector-production.up.railway.app/api/recordings/292/audio", "text": "पळय्नाशिल वारि केल्लें तान्नें शेज़ार्चांक", "duration": 4.4625}
{"audio_filepath": "https://konkanicollector-production.up.railway.app/api/recordings/104/audio", "text": "बब्रुलिंगप्पागले समर्पण", "duration": 3.205}
