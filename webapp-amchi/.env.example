# Copy to .env.local and fill in your keys. Never commit .env.local to git.

# Google Cloud Text-to-Speech API key (used for English TTS output)
# Enable "Cloud Text-to-Speech API" in Google Cloud Console
GOOGLE_TTS_API_KEY=

# Gemini API key (used for Amchi Konkani → English translation)
# Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Konkani collector (Express + Postgres on Railway) — receives
# /demo/live feedback, events, and survey data via the proxy routes
# under src/app/api/(feedback|events|survey)/*.
# COLLECTOR_BASE_URL: e.g. https://konkanicollector-production.up.railway.app
# COLLECTOR_API_KEY:  shared secret matching the collector's same env var
COLLECTOR_BASE_URL=
COLLECTOR_API_KEY=
